<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="unihealth_00007" author="uniwa">
        <createTable tableName="t_optional_health_profile">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true"/>
            </column>
            <column name="created_by" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
            <column name="created_on" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="modified_by" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
            <column name="modified_on" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="bigint">
                <constraints nullable="false"/>
            </column>

            <column name="health_profile_id" type="varchar(36)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="sleep_quality" type="varchar(50)"/>
            <column name="study_load" type="varchar(50)"/>
            <column name="smoking" type="varchar(50)"/>
            <column name="coffee" type="varchar(50)"/>
            <column name="screen_time" type="varchar(50)"/>
            <column name="exercise" type="varchar(50)"/>
            <column name="meals_per_day" type="varchar(50)"/>
            <column name="eat_snack" type="varchar(50)"/>
            <column name="water" type="varchar(50)"/>
            <column name="diet_type" type="varchar(50)"/>
            <column name="medication" type="boolean"/>
            <column name="medication_details" type="varchar(255)"/>
            <column name="surgery_history" type="boolean"/>
            <column name="surgery_details" type="varchar(255)"/>
            <column name="preferred_content" type="varchar(50)"/>
            <column name="frequency" type="varchar(50)"/>
            <column name="comments" type="varchar(1000)"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="t_optional_health_profile"
                baseColumnNames="health_profile_id"
                referencedTableName="t_health_profile"
                referencedColumnNames="id"
                constraintName="fk_optional_health_profile_health_profile"
                onDelete="CASCADE"/>


    </changeSet>
</databaseChangeLog>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="unihealth_00006" author="uniwa">
        <addColumn tableName="t_user">
            <column name="health_profile_completed" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="health_profile_completed_on" type="timestamp"/>
        </addColumn>

        <createTable tableName="t_health_profile">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true"/>
            </column>
            <column name="created_by" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
            <column name="created_on" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="modified_by" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
            <column name="modified_on" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="bigint">
                <constraints nullable="false"/>
            </column>

            <column name="user_id" type="varchar(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="date_of_birth" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="gender" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="height_cm" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="weight_kg" type="decimal(5,2)">
                <constraints nullable="false"/>
            </column>
            <column name="has_food_allergies" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="food_allergies_details" type="varchar(1000)"/>
            <column name="has_chronic_conditions" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="chronic_conditions_details" type="varchar(1000)"/>
            <column name="primary_goal" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="t_health_profile"
                baseColumnNames="user_id"
                referencedTableName="t_user"
                referencedColumnNames="id"
                constraintName="fk_health_profile_user"/>

    </changeSet>
</databaseChangeLog>
